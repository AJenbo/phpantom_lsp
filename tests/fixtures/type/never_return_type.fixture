// test: never return type is treated as dead code — variable retains pre-branch type
// feature: completion
// Adapted from phpactor type/never.test
// `never_return()` terminates the branch, so `$obj = new Bar()` is dead
// and $obj is still Foo after the if.  Asserted through completion rather
// than hover because hover collapses a branch-merged union to its first
// member (B22).
// expect: fooMethod(
// expect_absent: barMethod(
---
<?php

class Foo {
    public function fooMethod(): void {}
}

class Bar {
    public function barMethod(): void {}
}

function never_return(): never
{
    die('nope');
}

function test(): void {
    $obj = new Foo();

    if (rand(0, 1)) {
        $obj = new Bar();
        never_return();
    }

    $obj-><>
}
