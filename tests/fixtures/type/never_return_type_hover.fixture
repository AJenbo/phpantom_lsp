// test: never return type is treated as dead code — hover shows the pre-branch type
// feature: hover
// Adapted from phpactor type/never.test
// `never_return()` terminates the branch, so `$obj = new Bar()` is dead and
// hover on $obj after the if shows Foo alone, with no Bar branch merged in.
// expect: $obj = Foo
// expect_absent: Bar
---
<?php

class Foo {
    public function fooMethod(): void {}
}

class Bar {
    public function barMethod(): void {}
}

function never_return(): never
{
    die('nope');
}

function test(): void {
    $obj = new Foo();

    if (rand(0, 1)) {
        $obj = new Bar();
        never_return();
    }

    echo $o<>bj;
}
