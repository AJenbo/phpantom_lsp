// test: guard calling a never-returning method on a property
// feature: completion
// expect: fooMethod(
// expect_absent: barMethod(
---
<?php

class Foo {
    public function fooMethod(): void {}
}

class Bar {
    public function barMethod(): void {}
}

class Aborter {
    public function fail(): never {
        throw new \RuntimeException();
    }
}

class Runner {
    private Aborter $aborter;

    public function test(Foo|Bar $x): void {
        if (!$x instanceof Foo) {
            $this->aborter->fail();
        }

        $x-><>
    }
}
