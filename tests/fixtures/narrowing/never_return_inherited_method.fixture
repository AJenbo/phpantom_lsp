// test: guard calling a never-returning method inherited from a parent
// feature: completion
// `fail()` is declared on Base, so finding it needs the inheritance merge
// expect: fooMethod(
// expect_absent: barMethod(
---
<?php

class Foo {
    public function fooMethod(): void {}
}

class Bar {
    public function barMethod(): void {}
}

class Base {
    public function fail(): never {
        throw new \RuntimeException();
    }
}

class Child extends Base {
    public function test(Foo|Bar $x): void {
        if (!$x instanceof Foo) {
            $this->fail();
        }

        $x-><>
    }
}
