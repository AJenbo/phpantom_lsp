// test: an impure call drops a property path narrowed through the receiver
// feature: hover
// A call on `$conn` can reassign anything it owns, so what the
// `instanceof` proved about `$conn->handle` no longer holds after it.
// expect: $h = Handle|null
---
<?php

class Handle {}

class Conn {
    public Handle|null $handle = null;

    public function reset(): void {}
}

function run(Conn $conn): void {
    if ($conn->handle instanceof Handle) {
        $conn->reset();
        $h = $conn->handle;
        echo $<>h;
    }
}
