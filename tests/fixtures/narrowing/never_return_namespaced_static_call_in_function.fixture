// test: a same-namespace class shadows a global one from a plain function
// feature: completion
// `Aborter::fail()` means App\Aborter::fail(), which returns void, so the
// branch does not terminate and both members stay available.  The guard sits
// in a plain function body, which has no enclosing class to read the
// namespace from.
// expect: fooMethod(
// expect: barMethod(
---
<?php

namespace {
    class Aborter {
        public static function fail(): never {
            throw new \RuntimeException();
        }
    }
}

namespace App {
    class Foo {
        public function fooMethod(): void {}
    }

    class Bar {
        public function barMethod(): void {}
    }

    class Aborter {
        public static function fail(): void {}
    }

    function test(Foo|Bar $x): void {
        if (!$x instanceof Foo) {
            Aborter::fail();
        }

        $x-><>
    }
}
