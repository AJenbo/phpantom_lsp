// test: guard calling a never-returning method on a local variable
// feature: completion
// The receiver is typed from the branch scope, not from `$this`
// expect: fooMethod(
// expect_absent: barMethod(
---
<?php

class Foo {
    public function fooMethod(): void {}
}

class Bar {
    public function barMethod(): void {}
}

class Aborter {
    public function fail(): never {
        throw new \RuntimeException();
    }
}

function test(Foo|Bar $x): void {
    $aborter = new Aborter();

    if (!$x instanceof Foo) {
        $aborter->fail();
    }

    $x-><>
}
