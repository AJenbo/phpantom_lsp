// test: a branch whose every nested path calls a never-returning function
// feature: completion
// expect: fooMethod(
// expect_absent: barMethod(
---
<?php

class Foo {
    public function fooMethod(): void {}
}

class Bar {
    public function barMethod(): void {}
}

function abort_now(): never {
    throw new \RuntimeException();
}

function test(Foo|Bar $x): void {
    if (!$x instanceof Foo) {
        if (rand(0, 1)) {
            abort_now();
        } else {
            abort_now();
        }
    }

    $x-><>
}
