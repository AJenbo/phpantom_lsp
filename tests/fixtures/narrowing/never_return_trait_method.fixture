// test: guard calling a never-returning method supplied by a trait
// feature: completion
// expect: fooMethod(
// expect_absent: barMethod(
---
<?php

class Foo {
    public function fooMethod(): void {}
}

class Bar {
    public function barMethod(): void {}
}

trait Aborts {
    public function fail(): never {
        throw new \RuntimeException();
    }
}

class Child {
    use Aborts;

    public function test(Foo|Bar $x): void {
        if (!$x instanceof Foo) {
            $this->fail();
        }

        $x-><>
    }
}
